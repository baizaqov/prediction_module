# Профиль сервиса gisbb-forecast. Скопируйте в .env для локального запуска.

APP_NAME=gisbb-forecast
SERVER_PORT=8100

# Локально можно использовать SQLite (схема не применяется):
# DATABASE_URL=sqlite:///./forecast_local.db
# Боевой профиль — общий gisbb_db, схема forecast:
DATABASE_URL=postgresql+psycopg://gisbb_service:qaZ-GiS-22-BB@localhost:5432/gisbb_db
FORECAST_DB_SCHEMA=forecast

# Внутренний токен шлюза (общий секрет платформы). Для локальной разработки без шлюза
# проверку можно отключить:
GISBB_INTERNAL_TOKEN_ENABLED=true
GISBB_INTERNAL_TOKEN_SECRET=supersecretkey_supersecretkey_supersecretkey

# Регистрация в Eureka (в кластере — true):
EUREKA_ENABLED=false
EUREKA_DEFAULT_ZONE=http://localhost:8761/eureka/

# Порог точности прогноза (ТЗ 4.10.6.2):
ACCURACY_TARGET=0.80
